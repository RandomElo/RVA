<h1 style="margin:0 0 16px; font-family:'Montserrat', Arial, sans-serif; font-size:22px; font-weight:600; color:#040F33;">
    Nouveau message de contact
</h1>

<p style="margin:0 0 20px; font-size:15px; line-height:1.6; color:#0B2270;">
    Un nouveau message a été envoyé depuis le formulaire de contact du site Running Vincennes Association.
</p>

<!-- Détails du message -->
<table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="margin:0 0 24px; border-radius:8px; background-color:#EAF0FB;">
    <tr>
        <td style="padding:20px 24px;">
            <p style="margin:0 0 12px; font-size:13px; line-height:1.5; color:#4574D2; font-family:'Work Sans', Arial, sans-serif;">
                Nom
            </p>
            <p style="margin:0 0 16px; font-size:15px; line-height:1.5; color:#040F33; font-family:'Work Sans', Arial, sans-serif;">
                {{nom}}
            </p>

            <p style="margin:0 0 12px; font-size:13px; line-height:1.5; color:#4574D2; font-family:'Work Sans', Arial, sans-serif;">
                E-mail
            </p>
            <p style="margin:0 0 16px; font-size:15px; line-height:1.5; color:#040F33; font-family:'Work Sans', Arial, sans-serif;">
                <a href="mailto:{{mail}}" style="color:#0F2C8F; text-decoration:none;">{{mail}}</a>
            </p>

            <p style="margin:0 0 12px; font-size:13px; line-height:1.5; color:#4574D2; font-family:'Work Sans', Arial, sans-serif;">
                Message
            </p>
            <p style="margin:0; font-size:15px; line-height:1.6; color:#040F33; font-family:'Work Sans', Arial, sans-serif; white-space:pre-line;">
                {{message}}
            </p>
        </td>
    </tr>
</table>

<!-- Bouton CTA -->
<table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 auto 24px;">
    <tr>
        <td align="center" style="border-radius:8px; background-color:#E8622C;">
            <a href="mailto:{{mail}}" style="display:inline-block; padding:14px 32px; font-size:15px; font-weight:600; color:#ffffff; text-decoration:none; font-family:'Work Sans', Arial, sans-serif;">
                Répondre à
                {{nom}}
            </a>
        </td>
    </tr>
</table>

<p style="margin:0; font-size:13px; line-height:1.6; color:#4574D2;">
    Ce message a été envoyé automatiquement depuis le formulaire de contact du site.
</p>