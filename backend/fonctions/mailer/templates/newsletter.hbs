<h1 style="margin:0 0 16px; font-family:'Montserrat', Arial, sans-serif; font-size:22px; font-weight:600; color:#040F33;">
    {{titre}}
</h1>

<p style="margin:0 0 24px; font-size:15px; line-height:1.6; color:#0B2270;">
    Bonjour
    {{prenom}},
    <br /><br />
    Une nouvelle newsletter est en ligne :
    <strong>{{titre}}</strong>. Découvrez-la dès maintenant en cliquant sur le bouton ci-dessous.
</p>

<!-- Bouton CTA -->
<table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 auto 24px;">
    <tr>
        <td align="center" style="border-radius:8px; background-color:#E8622C;">
            <a href="{{lien}}" style="display:inline-block; padding:14px 32px; font-size:15px; font-weight:600; color:#ffffff; text-decoration:none; font-family:'Work Sans', Arial, sans-serif;">
                Lire la newsletter
            </a>
        </td>
    </tr>
</table>

<p style="margin:0 0 8px; font-size:13px; line-height:1.6; color:#4574D2; text-align:center;">
    Ou copiez-collez ce lien dans votre navigateur :
</p>
<p style="margin:0 0 32px; font-size:13px; line-height:1.6; text-align:center; word-break:break-all;">
    <a href="{{lien}}" style="color:#0F2C8F;">{{lien}}</a>
</p>

<!-- Séparateur -->
<hr style="border:none; border-top:1px solid #E0E0E0; margin:0 0 16px;" />

<!-- Lien de désinscription -->
<p style="margin:0; font-size:12px; line-height:1.5; color:#718096; text-align:center; font-family:Arial, sans-serif;">
    Pour ne plus recevoir les newsletters,
    <a href="{{lien_desinscription}}" style="color:#4574D2; text-decoration:underline;">cliquez sur ce lien</a>.
</p>