<h1 style="margin:0 0 16px; font-family:'Montserrat', Arial, sans-serif; font-size:22px; font-weight:600; color:#040F33;">
    Bonjour {{prenom}},
</h1>

<p style="margin:0 0 24px; font-size:15px; line-height:1.6; color:#0B2270; white-space:pre-line;">{{corps}}</p>

{{#if liens}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 24px;">
    {{#each liens}}
    <tr>
        <td style="padding-bottom:12px;" align="center">
            <table role="presentation" cellpadding="0" cellspacing="0">
                <tr>
                    <td align="center" style="border-radius:8px; background-color:#E8622C;">
                        <a href="{{this.url}}" style="display:inline-block; padding:14px 32px; font-size:15px; font-weight:600; color:#ffffff; text-decoration:none; font-family:'Work Sans', Arial, sans-serif;">
                            {{this.libelle}}
                        </a>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
    {{/each}}
</table>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 8px;">
    {{#each liens}}
    <tr>
        <td style="padding-bottom:4px; font-size:13px; line-height:1.6; text-align:center; word-break:break-all;">
            <a href="{{this.url}}" style="color:#0F2C8F;">{{this.url}}</a>
        </td>
    </tr>
    {{/each}}
</table>
{{/if}}

{{#if piecesJointes}}
<p style="margin:24px 0 0; font-size:13px; line-height:1.6; color:#4574D2; text-align:center;">
    📎 {{piecesJointes.length}} pièce{{#if (gt piecesJointes.length 1)}}s{{/if}} jointe{{#if (gt piecesJointes.length 1)}}s{{/if}} à cet e-mail.
</p>
{{/if}}