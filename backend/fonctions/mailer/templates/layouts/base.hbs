<html lang="fr">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{{subject}}</title>
    </head>
    <body style="margin:0; padding:0; background-color:#EAF0FB; font-family: 'Work Sans', Arial, sans-serif;">

        <!-- Preheader (texte caché, aperçu dans la boîte de réception) -->
        <div style="display:none; max-height:0; overflow:hidden; opacity:0;">
            {{#if preheader}}{{preheader}}{{/if}}
        </div>

        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#EAF0FB; padding:32px 16px;">
            <tr>
                <td align="center">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px; background-color:#ffffff; border-radius:12px; overflow:hidden; border:1px solid #C7D7F4;">

                        <!-- HEADER -->
                        <tr>
                            <td style="background-color:#0F2C8F; padding:24px 32px; text-align:center;">
                                <!-- Remplacer par le vrai logo (URL publique) si besoin -->
                                <span style="font-family:'Montserrat', Arial, sans-serif; font-weight:600; font-size:20px; color:#ffffff; letter-spacing:0.5px;">
                                    Running Vincennes Association
                                </span>
                            </td>
                        </tr>

                        <!-- BODY (contenu injecté par chaque template) -->
                        <tr>
                            <td style="padding:32px;">
                                {{{body}}}
                            </td>
                        </tr>

                        <!-- FOOTER -->
                        <tr>
                            <td style="background-color:#EAF0FB; padding:20px 32px; text-align:center;">
                                <p style="margin:0; font-size:12px; color:#4574D2; line-height:1.6;">
                                    ©
                                    {{year}}
                                    Running Vincennes Association — Tous droits réservés<br />
                                    Vous recevez cet e-mail car vous êtes membre du club.
                                </p>
                            </td>
                        </tr>

                    </table>
                </td>
            </tr>
        </table>

    </body>
</html>